# Copy to .env. Never commit .env — this repo is public.

# DeepSeek API (official). Default chat when DEEPSEEK_API_KEY is set and
# PUCK_CHAT is empty. Thinking on by default; effort low/high/max
# (medium and xhigh map to high). Images: this model is vision — the API
# accepts image_url parts (base64 or public URL).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_CODER_MODEL=deepseek-v4-flash-vision-exp

# NanoGPT. One key for chat and create_image.
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_MODEL=openai/gpt-5.6-luna
NANOGPT_CODER_MODEL=openai/gpt-5.6-luna
NANOGPT_IMAGE_MODEL=nano-banana-2-fast
# NANOGPT_IMAGE_URL=https://nano-gpt.com/api/v1/images

# Chat provider: deepseek (default if DEEPSEEK_API_KEY is set), nano
# (if only NANOGPT_API_KEY is set), openrouter, or google.
# Force one: PUCK_CHAT=deepseek|nano|openrouter|google.
# Images always use NANOGPT_API_KEY.
# PUCK_CHAT=deepseek
# PUCK_CHAT=nano
# PUCK_CHAT=openrouter
# PUCK_CHAT=google

# Gemini API (AI Studio). Used when PUCK_CHAT=google.
# Native generateContent (not the /openai compat URL). Model id is Google's
# (gemini-3.7-flash), not google/…
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_MODEL=gemini-3.7-flash
# GOOGLE_CODER_MODEL=gemini-3.7-flash

# OpenRouter. Used when PUCK_CHAT=openrouter, or when NANOGPT_API_KEY is empty.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_CODER_MODEL=openai/gpt-5.6-luna

# Coder workspace. Default: the computer root (/) until the User picks a
# folder in the window (button: Select a folder). The last picked folder
# is saved and restored on launch.
# PUCK_WORKSPACE= overrides the picker (dev). The folder is home (listing
# injected, relative paths, default cwd). The rest of this Mac is reachable
# except ~/.ssh, ~/.gnupg, ~/.aws, ~/.netrc, and this app's .env.


# Context for this order (not long-term memory). A Coder job
# keeps ~256k tokens of messages before prune/compact.
# PUCK_COMPACT_RAW_TOKENS=256000
# PUCK_SUMMARY_MAX_TOKENS=64000
# PUCK_PACK_MAX_TOKENS=400000
# PUCK_KEEP_EXCHANGES=20
# PUCK_KEEP_MIN_EXCHANGES=3
# PUCK_KEEP_MAX_TOKENS=40000
# PUCK_API_MAX_TOKENS=400000
# PUCK_API_RESERVE_TOKENS=32000
# PUCK_PRUNE_KEEP_TURNS=4

# Local filo on this computer (turns + summary files + window). Default: ./context
# Cloud / database later. Do not commit this folder — it is gitignored.
# PUCK_CONTEXT=

# Vault: the root folder of projects (one folder per project, each with
# .puck/memory.md and .puck/schema.md). Default: ~/puck-lavori.
# PUCK_VAULT=

# User memory (vault/user.md): who they are, preferences, standing facts,
# plus short notes on folders they have worked in (name + full path).
# Each project's live picture is its own .puck/memory.md.
# Everyone reads and edits those files. Update before a handoff, and when a
# piece finishes. At 100000 tokens an add is still accepted, then the file is
# compacted to about 20000 tokens before the next call continues.
# PUCK_COMUNE_MAX_TOKENS=100000
# PUCK_COMUNE_KEEP_TOKENS=20000
# Project memory (.puck/memory.md): cap 160k, keeps ~128k of organized
# entries with ids ([m-N], add/replace/remove).
# PUCK_PROJECT_MAX_TOKENS=160000
# PUCK_PROJECT_KEEP_TOKENS=128000

# Puck Cloud (Supabase). Sync del vault: pull all'avvio ("Preparing
# workspace"), check a inizio task, push a fine lavoro e a chiusura app.
# Setup una tantum: vedi cloud-setup.md. Bucket: puck (privato).
# PUCK_SUPABASE_URL=
# PUCK_SUPABASE_ANON_KEY=
