{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puck",
  "version": "0.0.2",
  "identifier": "app.puck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Puck",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../crew/*.md": "crew/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "puck"
        ]
      }
    }
  }
}
